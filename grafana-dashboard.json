      "targets": [{ "expr": "max(tt_dram_used_bytes / tt_dram_total_bytes * 100)", "legendFormat": "Max %", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
