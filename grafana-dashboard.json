      "title": "Temperature",
      "type": "timeseries",
      "targets": [{ "expr": "tt_temperature_celsius{device=~\"$device\"}", "legendFormat": "Dev {{device}} ({{arch}})", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
