## Usage Examples

### Example 1: Monitoring Tool (tt-ctl)

```cpp
#include "umd/device/topology/multi_arch_topology_discovery.hpp"

// Discover all architectures with remote devices
TopologyDiscoveryOptions options;
options.no_remote_discovery = false;  // Include n300 remote chips
options.no_eth_firmware_strictness = true;
options.no_wait_for_eth_training = true;

auto clusters = MultiArchTopologyDiscovery::discover_by_architecture(options);

// Process each architecture's devices
for (auto& [arch, cluster] : clusters) {
    if (!cluster.discovery_successful) {
        std::cerr << "Failed to discover " << arch << ": " 
                  << cluster.error_message << std::endl;
        continue;
    }
    
    std::cout << get_arch_name(arch) << " cluster: " 
              << cluster.devices.size() << " devices" << std::endl;
    
    for (auto& [asic_id, tt_device] : cluster.devices) {
        auto* telem = tt_device->get_arc_telemetry_reader();
        float temp = telem->read_entry(TelemetryTag::ASIC_TEMPERATURE);
        float power = telem->read_entry(TelemetryTag::TDP);
        
        std::cout << "  Device " << std::hex << asic_id << std::dec
                  << " (" << (tt_device->is_remote() ? "remote" : "local") << ")"
                  << ": " << temp << "°C, " << power << "W" << std::endl;
    }
}
```

### Example 2: Runtime Architecture Selection

```cpp
// User specifies target architecture for workload
tt::ARCH target_arch = parse_user_config();  // e.g., WORMHOLE_B0

// Discover only target architecture
auto cluster = MultiArchTopologyDiscovery::discover_single_architecture(target_arch);

if (!cluster.discovery_successful) {
    throw std::runtime_error("Target architecture not available");
}

// Initialize devices for execution
for (auto& [id, device] : cluster.devices) {
    initialize_for_execution(device.get());
}
```

### Example 3: Query Available Architectures

```cpp
// Check what architectures are present before discovery
auto available = MultiArchTopologyDiscovery::get_available_architectures();

std::cout << "Available architectures: ";
for (tt::ARCH arch : available) {
    std::cout << get_arch_name(arch) << " ";
}
std::cout << std::endl;

// Discover only if target arch is available
if (available.count(tt::ARCH::BLACKHOLE)) {
    auto bh_cluster = MultiArchTopologyDiscovery::discover_single_architecture(
        tt::ARCH::BLACKHOLE
    );
}
```

